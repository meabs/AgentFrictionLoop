{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "analysis-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_id", "domain", "repository", "commit", "commit_short", "parents", "timestamp", "analysed_at", "changed_files", "diff_stats", "verification", "documentation", "guidance", "observations", "agent"],
  "properties": {
    "schema_version": {"const": "1.0"}, "record_id": {"type": "string", "minLength": 1}, "domain": {"type": "string"}, "repository": {"type": "string", "minLength": 1},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "commit_short": {"type": "string", "pattern": "^[0-9a-f]{12}$"},
    "parents": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{40}$"}},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "analysed_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "changed_files": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["path", "status"], "properties": {"path": {"type": "string"}, "status": {"enum": ["A", "M", "D", "R"]}}}},
    "diff_stats": {"type": "object", "additionalProperties": false, "required": ["files", "insertions", "deletions", "by_category"], "properties": {"files": {"type": "integer", "minimum": 0}, "insertions": {"type": "integer", "minimum": 0}, "deletions": {"type": "integer", "minimum": 0}, "by_category": {"type": "object", "additionalProperties": false, "required": ["source", "tests", "docs", "config", "guidance", "other"], "properties": {"source": {"type": "integer", "minimum": 0}, "tests": {"type": "integer", "minimum": 0}, "docs": {"type": "integer", "minimum": 0}, "config": {"type": "integer", "minimum": 0}, "guidance": {"type": "integer", "minimum": 0}, "other": {"type": "integer", "minimum": 0}}}}},
    "verification": {"type": "object", "additionalProperties": false, "required": ["tests", "lint", "build"], "properties": {"tests": {"enum": ["passed", "failed", "unknown"]}, "lint": {"enum": ["passed", "failed", "unknown"]}, "build": {"enum": ["passed", "failed", "unknown"]}, "details": {"type": "object", "additionalProperties": false, "properties": {"tests": {"type": "object"}, "lint": {"type": "object"}, "build": {"type": "object"}}}}},
    "documentation": {"type": "object", "additionalProperties": false, "required": ["agents_md_present", "claude_md_present", "service_yaml_present", "okf_present", "adr_present", "api_schema_present", "skills_present", "readme_present", "relevant_docs_changed"], "properties": {"agents_md_present": {"type": "boolean"}, "claude_md_present": {"type": "boolean"}, "service_yaml_present": {"type": "boolean"}, "okf_present": {"type": "boolean"}, "adr_present": {"type": "boolean"}, "api_schema_present": {"type": "boolean"}, "skills_present": {"type": "boolean"}, "readme_present": {"type": "boolean"}, "relevant_docs_changed": {"type": "boolean"}}},
    "guidance": {"type": "object", "additionalProperties": false, "required": ["digest", "file_count", "skills_available", "agents_md_referenced_paths", "guidance_changed"], "properties": {"digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "file_count": {"type": "integer", "minimum": 0}, "skills_available": {"type": "array", "items": {"type": "string"}}, "agents_md_referenced_paths": {"type": "array", "items": {"type": "string"}}, "guidance_changed": {"type": "boolean"}}},
    "observations": {"type": "array", "items": {"type": "string"}}, "friction": {"type": "array", "maxItems": 20, "items": {"type": "object", "additionalProperties": false, "required": ["category", "text", "source"], "properties": {"category": {"enum": ["setup", "test-order", "missing-doc", "unclear-instruction", "environment", "tooling", "other"]}, "text": {"type": "string", "maxLength": 240}, "source": {"enum": ["event", "trailer"]}, "origin": {"enum": ["repository-discovery", "task-context", "execution-environment", "verification", "conflicting-knowledge"]}}}}, "actor": {"type": "object", "additionalProperties": false, "required": ["id", "scheme", "kind"], "properties": {"id": {"type": "string", "pattern": "^[0-9a-f]{12}$"}, "scheme": {"const": "hmac-sha256/v1"}, "kind": {"enum": ["human", "bot"]}}}, "agent": {"type": "object", "additionalProperties": false, "required": ["harness"], "properties": {"harness": {"enum": ["unknown", "codex", "claude-code", "cursor", "copilot", "gemini", "human"]}}},
    "execution": {"type": "object", "properties": {"verification_attempts": {"type": "array", "items": {"type": "object", "properties": {"kind": {"type": "string"}, "exit_code": {"type": ["integer", "null"]}}}}}}, "harness_telemetry": {"type": "object", "properties": {"model": {"type": ["string", "null"]}, "evidence_level": {"enum": ["transcript", "boundary"]}}}
  }
}
